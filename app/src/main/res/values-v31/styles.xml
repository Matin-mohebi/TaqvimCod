<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: system splash screen stays in charge of the cold-start
         animation; the windowBackground beneath it carries the same branding. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:windowSplashScreenBackground">@color/grad_start_solid</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
