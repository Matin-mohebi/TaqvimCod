<?xml version="1.0" encoding="utf-8"?>
<!--
    Cold-start windowBackground splash: theme hero gradient + the centered
    "ت" logo box (same mark as the top bar). Intentionally minimal so it stays
    safe on Android 12+ where the system splash screen owns the cold-start
    animation — this layer only brands the window behind it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#103B50"
                android:endColor="#087F75"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="104dp"
        android:height="104dp"
        android:drawable="@drawable/splash_logo" />
</layer-list>
